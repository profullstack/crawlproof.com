# Reference systemd unit for the port-drift prober (docs/uptime-monitoring-prd.md §12).
# Install on the DigitalOcean droplet:
#   sudo cp prober/deploy/crawlproof-prober.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now crawlproof-prober
#
# The deploy-prober GitHub Action runs `systemctl restart crawlproof-prober`
# after pulling + building. REDIS_URL (rediss://) is the only credential the
# droplet holds; scope it to a dedicated instance/ACL for the "prober" queue.

[Unit]
Description=CrawlProof port-drift prober (BullMQ worker)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
WorkingDirectory=/opt/crawlproof.com/prober
# Provide REDIS_URL (and any prober config) via this env file, root-owned 0600.
EnvironmentFile=/etc/crawlproof-prober.env
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=5
# Hardening — the prober needs only outbound network + nmap.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/crawlproof.com/prober

[Install]
WantedBy=multi-user.target
